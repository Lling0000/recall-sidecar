{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/codex-local-memory-hook\" session-start",
            "statusMessage": "Checking codex-local-memory sidecar",
            "timeout": 1
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/codex-local-memory-hook\" user-prompt-submit",
            "statusMessage": "Recalling local corrections",
            "timeout": 1
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/bin/codex-local-memory-hook\" stop",
            "statusMessage": "Queueing local correction extraction",
            "timeout": 1
          }
        ]
      }
    ]
  }
}

