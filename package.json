{
  "name": "codex-local-memory",
  "version": "0.1.0",
  "description": "Repository-scoped local tacit knowledge sidecar for coding agents",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "bin": {
    "codex-local-memory": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node --import tsx scripts/copy-assets.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src tests scripts",
    "format": "biome check --write src tests scripts",
    "check:structure": "node --import tsx scripts/check-structure.ts",
    "test": "npm run test:core && npm run test:host",
    "test:core": "node --import tsx --test tests/core/*.test.ts",
    "test:host": "node --import tsx --test tests/host/*.test.ts",
    "test:docker": "docker build --target test -t codex-local-memory-test .",
    "check:docs": "node --import tsx scripts/check-doc-consistency.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@phosphor-icons/web": "^2.1.2",
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
